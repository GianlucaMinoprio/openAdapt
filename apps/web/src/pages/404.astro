---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <link
      rel="preload"
      href="/fonts/inter.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-tight.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found — OpenAdapt</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <main class="wrap legal">
      <span class="mono">404 / A STEP OFF THE PATH</span>
      <h1>
        Let’s get you
        <br />
        back on your feet.
      </h1>
      <p>
        This page doesn’t exist. The project, app preview, and release status
        are all on our home page.
      </p>
      <a class="button button-blue" href="/">
        Back to OpenAdapt →
      </a>
    </main>
  </body>
</html>
